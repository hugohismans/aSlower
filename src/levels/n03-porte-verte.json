  "bulles": [
    {
      "id": "n03-porte",
      "texte": "Cette porte s'ouvre si sa lampe te paraît verte. Regarde-la changer en roulant.",
      "priorite": 3,
      "note": "Premiere porte en vue (moins de deux portees).",
      "quand": {
        "tous": [
          {
            "var": "porteProche"
          },
          {
            "var": "teintePorte",
            "op": "!=",
            "val": "noir"
          }
        ]
      }
    },
    {
      "id": "n03-relache",
      "texte": "Vert ! Relâche : tu gardes cette vitesse, la porte va s'ouvrir.",
      "priorite": 4,
      "quand": {
        "tous": [
          {
            "var": "porteProche"
          },
          {
            "var": "teinteVoulue"
          },
          {
            "var": "accelere"
          }
        ]
      }
    },
    {
      "id": "n03-trop-vite",
      "texte": "Trop vite : la lampe a dépassé le vert. Freine un peu !",
      "priorite": 4,
      "quand": {
        "tous": [
          {
            "var": "porteProche"
          },
          {
            "un": [
              {
                "var": "teintePorte",
                "op": "==",
                "val": "cyan"
              },
              {
                "var": "teintePorte",
                "op": "==",
                "val": "bleu"
              },
              {
                "var": "teintePorte",
                "op": "==",
                "val": "violet"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "n03-ir",
      "texte": "Cette lampe semble éteinte ? Elle brille en infrarouge. Fonce vers elle !",
      "priorite": 3,
      "quand": {
        "tous": [
          {
            "var": "porteProche"
          },
          {
            "var": "teintePorte",
            "op": "==",
            "val": "noir"
          },
          {
            "var": "beta",
            "op": "<",
            "val": 0.2
          }
        ]
      }
    }
  ],
  "indices": [
    {
      "apresEchecs": 1,
      "texte": "Regarde la lampe changer : rouge, orange, jaune… vert ! Relâche à ce moment-là."
    },
    {
      "apresEchecs": 2,
      "texte": "La bande verte sur le compteur montre la vitesse qui ouvre la prochaine porte.",
